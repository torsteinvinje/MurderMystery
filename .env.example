# Copy to .env and fill in the values from the Supabase dashboard
# (Project Settings -> API). Only these two PUBLIC values may ever appear
# in client code. The service-role key must NEVER go here or in the repo.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional feature flag for the "Skjult agenda" game mode. Defaults to off
# (unset, or anything other than the literal string "true"). This only hides
# the UI entry point — the real gate is the database's own
# app_feature_flags('SABOTEUR_GAME_ENABLED') row, which also defaults to
# false and must be enabled separately in Supabase.
VITE_SABOTEUR_GAME_ENABLED=false
